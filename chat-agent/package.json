{
  "name": "maple-chat-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "evals": "node --env-file=.env -r ts-node/register/transpile-only evals/run-evals.ts",
    "setup-db": "node --env-file=.env -r ts-node/register/transpile-only scripts/setup-db.ts",
    "start": "node --env-file=.env -r ts-node/register/transpile-only src/server.ts"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.2",
    "@ag-ui/encoder": "1.0.2",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "express": "^4.18.2",
    "langchain": "^1.5.20",
    "pg": "^8.13.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@electric-sql/pglite-pgvector": "^0.0.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "^22"
  }
}
