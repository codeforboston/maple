# Gemini API key for the chat model and memory embeddings
GOOGLE_API_KEY=
# Chat model id, e.g. a Gemini Flash model
CHAT_MODEL=
# Memory embeddings: gemini-embedding-001 at 768 dims, L2-normalized in embed()
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
# MAPLE's MCP server, for bill, testimony and sponsor search (dev: https://maple-dev.vercel.app/api/mcp)
MAPLE_MCP_URL=
# An MCP agent key (Firestore agentKeys), or a Firebase ID token from /dev/token for a quick local test
MAPLE_MCP_TOKEN=
# Postgres with pgvector, for chat threads, checkpoints and memory (run `yarn setup-db` once)
DATABASE_URL=
# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Monthly token caps: per user, and all users together (spend ceiling)
MONTHLY_TOKEN_BUDGET=200000
GLOBAL_MONTHLY_TOKEN_BUDGET=2000000
# Bearer token the Next.js server sends to this service (32+ chars; generate with: openssl rand -hex 32)
AGENT_SERVICE_TOKEN=
