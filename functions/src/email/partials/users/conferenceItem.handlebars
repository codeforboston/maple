{{!-- Testimony on a committee of conference: the bill links its conference,
  and the stance is in words where a bill stance has an image --}}
<td style="width: 100px">
  <div style="text-decoration-line: underline; display: inline-block; margin-right: 15px">
    <a href="https://mapletestimony.org/conferences/{{court}}/{{conferenceId}}" target="_blank" rel="noopener noreferrer" style="color: inherit">
      {{billId}}
    </a>
  </div>
</td>
<td style="width: 100px; font-size: 14px; font-weight: 600; line-height: 125%">
  {{stance}}
</td>
